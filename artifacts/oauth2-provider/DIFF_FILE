+
+async function load() {
+  loading.value = true
+  loadError.value = ''
+  try {
+    applyConfig(await getOAuth2ProviderConfig())
+  } catch (error) {
+    loadError.value = extractApiErrorMessage(error, t('admin.settings.oauth2Provider.loadFailed'))
+  } finally {
+    loading.value = false
+  }
