+// errAfterReader 读完 data 后返回 err，模拟上游连接中途断开。
+type errAfterReader struct {
+	data *strings.Reader
+	err  error
+}
+
+func (r *errAfterReader) Read(p []byte) (int, error) {
+	if r.data.Len() > 0 {
+		return r.data.Read(p)
+	}
+	return 0, r.err
+}
