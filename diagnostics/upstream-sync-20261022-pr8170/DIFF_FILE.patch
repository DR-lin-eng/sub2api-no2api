diff --git a/backend/internal/application/service/account_model_mapping_signature.go b/backend/internal/application/service/account_model_mapping_signature.go
new file mode 100644
index 000000000..2d2db31a6
--- /dev/null
+++ b/backend/internal/application/service/account_model_mapping_signature.go
@@ -0,0 +1,53 @@
+package service
+
+const (
+	modelMappingSignatureFNVOffset = 14695981039346656037
+	modelMappingSignatureFNVPrime  = 1099511628211
+)
+
+// modelMappingSignature 计算原始映射内容的进程内校验值，与 map 遍历顺序无关且不分配内存。
+// 每个条目把 key、分隔字节 0 与 value（string 写其字节，其它类型写标记字节 1）
+// 放进同一个 FNV-1a 哈希并经 fmix64 收尾，再对所有条目求和；
+// key 与 value 同在一个条目哈希里，交换两个 key 的 value 会改变结果。
+func modelMappingSignature(rawMapping map[string]any) uint64 {
+	if len(rawMapping) == 0 {
+		return 0
+	}
+	var sum uint64
+	for k, v := range rawMapping {
+		h := uint64(modelMappingSignatureFNVOffset)
+		h = fnv1aString(h, k)
+		h = fnv1aByte(h, 0)
+		if s, ok := v.(string); ok {
+			h = fnv1aString(h, s)
+		} else {
+			h = fnv1aByte(h, 1)
+		}
+		sum += fmix64(h)
+	}
+	return sum
+}
+
+func fnv1aString(h uint64, s string) uint64 {
+	for i := 0; i < len(s); i++ {
+		h ^= uint64(s[i])
+		h *= modelMappingSignatureFNVPrime
+	}
+	return h
+}
+
+func fnv1aByte(h uint64, b byte) uint64 {
+	h ^= uint64(b)
+	h *= modelMappingSignatureFNVPrime
+	return h
+}
+
+// fmix64 是 MurmurHash3 的 64 位收尾函数，使条目哈希各位充分混合后再求和。
+func fmix64(h uint64) uint64 {
+	h ^= h >> 33
+	h *= 0xff51afd7ed558ccd
+	h ^= h >> 33
+	h *= 0xc4ceb9fe1a85ec53
+	h ^= h >> 33
+	return h
+}
diff --git a/backend/internal/application/service/account_model_mapping_signature_test.go b/backend/internal/application/service/account_model_mapping_signature_test.go
new file mode 100644
index 000000000..a83c05dc8
--- /dev/null
+++ b/backend/internal/application/service/account_model_mapping_signature_test.go
@@ -0,0 +1,96 @@
+//go:build unit
+
+package service
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestModelMappingSignature_IndependentOfInsertionOrder(t *testing.T) {
+	const size = 64
+	forward := make(map[string]any, size)
+	backward := make(map[string]any, size)
+	for i := 0; i < size; i++ {
+		forward[fmt.Sprintf("model-%02d", i)] = fmt.Sprintf("upstream-%02d", i)
+	}
+	for i := size - 1; i >= 0; i-- {
+		backward[fmt.Sprintf("model-%02d", i)] = fmt.Sprintf("upstream-%02d", i)
+	}
+	forward["non-string"] = 42
+	backward["non-string"] = 42
+
+	want := modelMappingSignature(forward)
+	require.NotZero(t, want)
+	for i := 0; i < 20; i++ {
+		require.Equal(t, want, modelMappingSignature(forward))
+		require.Equal(t, want, modelMappingSignature(backward))
+	}
+}
+
+func TestModelMappingSignature_DetectsContentChanges(t *testing.T) {
+	base := map[string]any{
+		"claude-sonnet": "sonnet-a",
+		"claude-opus":   "opus-a",
+		"gpt-5":         "gpt-5-upstream",
+	}
+	baseSig := modelMappingSignature(base)
+
+	cases := map[string]map[string]any{
+		"value changed": {
+			"claude-sonnet": "sonnet-b",
+			"claude-opus":   "opus-a",
+			"gpt-5":         "gpt-5-upstream",
+		},
+		"key renamed": {
+			"claude-sonnet-x": "sonnet-a",
+			"claude-opus":     "opus-a",
+			"gpt-5":           "gpt-5-upstream",
+		},
+		"values swapped between keys": {
+			"claude-sonnet": "opus-a",
+			"claude-opus":   "sonnet-a",
+			"gpt-5":         "gpt-5-upstream",
+		},
+		"string value replaced by non-string": {
+			"claude-sonnet": 1,
+			"claude-opus":   "opus-a",
+			"gpt-5":         "gpt-5-upstream",
+		},
+		"entry removed": {
+			"claude-sonnet": "sonnet-a",
+			"claude-opus":   "opus-a",
+		},
+	}
+	for name, changed := range cases {
+		require.NotEqual(t, baseSig, modelMappingSignature(changed), name)
+	}
+
+	// 非 string 的 value 统一按类型标记参与签名，具体取值不影响结果。
+	require.Equal(t,
+		modelMappingSignature(map[string]any{"m": 1}),
+		modelMappingSignature(map[string]any{"m": true}),
+	)
+}
+
+func TestModelMappingSignature_EmptyIsZero(t *testing.T) {
+	require.Zero(t, modelMappingSignature(nil))
+	require.Zero(t, modelMappingSignature(map[string]any{}))
+}
+
+func TestModelMappingSignature_DoesNotAllocate(t *testing.T) {
+	mapping := map[string]any{
+		"claude-sonnet": "sonnet-a",
+		"claude-opus":   "opus-a",
+		"gpt-5":         "gpt-5-upstream",
+		"non-string":    3.14,
+	}
+	var sink uint64
+	allocs := testing.AllocsPerRun(1000, func() {
+		sink += modelMappingSignature(mapping)
+	})
+	require.Zero(t, allocs)
+	require.NotZero(t, sink)
+}
