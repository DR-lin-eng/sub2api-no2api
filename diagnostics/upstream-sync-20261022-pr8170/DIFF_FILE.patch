+	service.HTTPUpstream
+	response *http.Response
+	calls    int
+}
+
+func (u *compatStreamUsageUpstream) DoWithTLS(*http.Request, string, int64, int, *tlsfingerprint.Profile) (*http.Response, error) {
+	u.calls++
+	return u.response, nil
+}
