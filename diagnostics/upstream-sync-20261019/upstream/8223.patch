+	conn, err = direct.DialContext(context.Background(), "tcp", net.JoinHostPort("localhost", port))
+	if conn != nil {
+		_ = conn.Close()
+	}
+	require.ErrorContains(t, err, "address not allowed for image download")
+	require.Zero(t, hits.Load())
