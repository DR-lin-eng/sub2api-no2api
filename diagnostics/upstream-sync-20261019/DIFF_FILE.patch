+
+	c.Status(resp.StatusCode)
+	c.Header("Cache-Control", "no-cache")
+	c.Header("Connection", "keep-alive")
+	c.Header("X-Accel-Buffering", "no")
+
+	// Native streaming is SSE by contract. Do not propagate an upstream
+	// text/plain (or other stale) content type to downstream SDKs.
+	c.Header("Content-Type", "text/event-stream; charset=utf-8")
+
+	flusher, ok := c.Writer.(http.Flusher)
+	if !ok {
+		return nil, errors.New("streaming not supported")
+	}
+
+	reader := bufio.NewReader(resp.Body)
+	usage := &ClaudeUsage{}
+	observer := upstreamResponseModelObserverFromContext(c)
+	if observer == nil {
+		observer = beginUpstreamResponseModelObservation(c)
+	}
+	var firstTokenMs *int
+	var best geminiResponseSignal
+	sawDataEvent := false
+	fallback := &geminiSSEFallbackBody{}
+	clientDisconnect, finished := false, false
+	writer := &geminiStreamWriteTracker{Writer: c.Writer}
+
+	for {
+		line, err := reader.ReadString('\n')
+		// A non-EOF read error leaves an incomplete line; never observe or forward it.
+		if len(line) > 0 && (err == nil || errors.Is(err, io.EOF)) {
+			trimmed := strings.TrimRight(line, "\r\n")
+			if strings.HasPrefix(trimmed, "data:") {
+				payload := strings.TrimSpace(strings.TrimPrefix(trimmed, "data:"))
+				// Keepalive / done markers
+				if payload == "" || payload == "[DONE]" {
+					_, _ = io.WriteString(writer, line)
+					flusher.Flush()
+				} else {
+					var rawToWrite string
+					rawToWrite = payload
+
+					var rawBytes []byte
+					if isOAuth {
+						innerBytes, err := unwrapGeminiResponse([]byte(payload))
+						if err == nil {
+							rawToWrite = string(innerBytes)
+							rawBytes = innerBytes
+						}
+					} else {
+						rawBytes = []byte(payload)
+					}
+					sawDataEvent = true
+					if sig, ok := detectGeminiResponseSignal(rawBytes); ok && sig.Kind > best.Kind {
+						best = sig
+					}
+
+					if u := extractGeminiUsage(rawBytes); u != nil {
+						usage = u
+					}
+					observer.ObserveGemini(rawBytes)
+
+					if firstTokenMs == nil {
+						ms := int(time.Since(startTime).Milliseconds())
+						firstTokenMs = &ms
+					}
+
+					if isOAuth {
+						// SSE format requires double newline (\n\n) to separate events
+						_, _ = fmt.Fprintf(writer, "data: %s\n\n", rawToWrite)
+					} else {
+						// Pass-through for AI Studio responses.
+						_, _ = io.WriteString(writer, line)
+					}
+					flusher.Flush()
+					if writer.err == nil {
+						observeGeminiImageOutputs(c, rawBytes)
+						if gjson.GetBytes(rawBytes, "candidates.0.finishReason").String() != "" {
+							finished = true
+						}
+					}
+				}
+			} else {
+				if !sawDataEvent {
+					fallback.AddLine(trimmed)
+				}
+				_, _ = io.WriteString(writer, line)
+				flusher.Flush()
+			}
+		}
+
+		if writer.err != nil {
+			clientDisconnect = true
+			break
+		}
+		if errors.Is(err, io.EOF) {
+			break
+		}
+		if err != nil {
+			if !geminiStreamAbortedWithBillableOutput(c, err, usage) {
+				return nil, err
+			}
+			clientDisconnect = true
+			break
+		}
+	}
+
+	s.finalizeGeminiSSESignal(c, account, true, upstreamRequestID, best, sawDataEvent, fallback)
+
+	return &geminiNativeStreamResult{usage: usage, firstTokenMs: firstTokenMs, clientDisconnect: clientDisconnect, finished: finished}, nil
+}
diff --git a/backend/internal/application/service/gemini_stream_client_abort.go b/backend/internal/application/service/gemini_stream_client_abort.go
new file mode 100644
index 000000000..8535469a8
--- /dev/null
+++ b/backend/internal/application/service/gemini_stream_client_abort.go
@@ -0,0 +1,53 @@
+package service
+
+import (
+	"errors"
+	"io"
+
+	"github.com/gin-gonic/gin"
+)
+
+// An internal upstream cancellation alone does not prove the client disconnected.
+func geminiStreamClientGone(c *gin.Context) bool {
+	return c != nil && c.Request != nil && c.Request.Context().Err() != nil
+}
+
+// Retain the last cumulative usage after client cancellation. Do not drain the
+// provider stream or convert a live client's upstream failure into success.
+func geminiStreamAbortedWithBillableOutput(c *gin.Context, err error, usage *ClaudeUsage) bool {
+	return err != nil && !errors.Is(err, io.EOF) && geminiStreamClientGone(c) &&
+		(usage.hasObservedTokens() || observedGeminiImageOutputs(c) > 0)
+}
+
+// Remember the first failed downstream write without changing the SSE encoder.
+// This is request-local and stops further writes to the broken connection.
+type geminiStreamWriteTracker struct {
+	io.Writer
+	err error
+}
+
+func (w *geminiStreamWriteTracker) Write(p []byte) (int, error) {
+	if w.err != nil {
+		return 0, w.err
+	}
+	n, err := w.Writer.Write(p)
+	if n < len(p) && err == nil {
+		err = io.ErrShortWrite
+	}
+	w.err = err
+	return n, err
+}
+
+// Preserve Gin/net/http's StringWriter path for large native SSE image lines.
+// Falling back to Write here would allocate a full []byte copy of each line.
+func (w *geminiStreamWriteTracker) WriteString(s string) (int, error) {
+	if w.err != nil {
+		return 0, w.err
+	}
+	n, err := io.WriteString(w.Writer, s)
+	if n < len(s) && err == nil {
+		err = io.ErrShortWrite
+	}
+	w.err = err
+	return n, err
+}
