+func TestAdminCredentialLoginCompatibility(t *testing.T) {
+	t.Parallel()
+	for _, email := range []string{"a@b", "Owner <owner@example.com>", "<owner@example.com>", strings.Repeat("a", 250) + "@example.com"} {
