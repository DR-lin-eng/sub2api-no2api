+func TestRefundPendingAuditPreventsLegacyDoubleDeduction(t *testing.T) {
+	ctx := context.Background()
+	client := newPaymentConfigServiceTestClient(t)
+	order := createCompletedRefundableOrderForTest(t, ctx, client, "legacy-reader")
+	svc := &PaymentService{entClient: client}
+	_, err := svc.markRefundPending(ctx, &RefundPlan{OrderID: order.ID, Order: order,
+		RefundAmount: 60, DeductionType: payment.DeductionTypeBalance, BalanceToDeduct: 60},
+		&payment.RefundResponse{RefundID: "held", Status: payment.ProviderStatusPending})
+	require.NoError(t, err)
+	entry, err := client.PaymentAuditLog.Query().Where(paymentauditlog.ActionEQ("REFUND_PENDING")).Only(ctx)
+	require.NoError(t, err)
+	// The old binary starts this field at true. Omitting false would deduct twice.
+	legacy := struct {
+		DeductionRollbackOK bool `json:"deductionRollbackOK"`
+	}{DeductionRollbackOK: true}
+	require.NoError(t, json.Unmarshal([]byte(entry.Detail), &legacy))
+	require.False(t, legacy.DeductionRollbackOK)
+	var detail refundPendingAuditDetail
+	require.NoError(t, json.Unmarshal([]byte(entry.Detail), &detail))
+	require.True(t, detail.DeductionHeld)
+}
