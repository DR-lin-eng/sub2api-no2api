+		{PlatformMiniMax, "https://api.minimax.com/v1"},
+	} {
+		t.Run(testCase.baseURL, func(t *testing.T) {
+			account := &Account{Platform: testCase.platform, Type: AccountTypeAPIKey, Credentials: map[string]any{
