+type openAIChatFallbackBoundaryReader struct {
+	io.Reader
+	beforeRead func()
+}
+
+func (reader *openAIChatFallbackBoundaryReader) Read(buffer []byte) (int, error) {
+	if reader.beforeRead != nil {
+		reader.beforeRead()
+		reader.beforeRead = nil
+	}
+	return reader.Reader.Read(buffer)
+}
