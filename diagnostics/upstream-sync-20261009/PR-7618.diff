+}
+
+func TestHandleUpstreamError_ClineStructuredErrorsPreserveCooldown(t *testing.T) {
+	for _, tc := range []struct {
+		name, model, body, scope, reason string
+		status                           int
+		wait                             time.Duration
+	}{
