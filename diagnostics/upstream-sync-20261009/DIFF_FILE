+			if scenario == "additional_declared" {
+				body = []byte(`{"input":[` + message + `,{"type":"web_search_call"},{"type":"additional_tools","tools":[{"type":"web_search"}]}],"tools":[]}`)
+			}
+			for _, impl := range []struct {
