+		}, key, []string{model}, 1, 1, 1, 1, UsageTokens{InputTokens: 5000, OutputTokens: 100}, "", false, false)
+		require.NoError(t, err)
+		require.InDelta(t, .6, resolved.Cost.TotalCost, 1e-12)
+	}
+}
