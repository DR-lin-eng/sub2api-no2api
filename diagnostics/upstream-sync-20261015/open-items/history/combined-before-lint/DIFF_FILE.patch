@@ -0,0 +1,16 @@
+# Model catalog
+
+`modelcatalog` owns bounded provider-neutral model descriptors and versioned snapshots. Application services fetch through the selected account's existing transport, capture metadata from the same response, and persist complete successful catalogs through a narrow repository port. This module does not perform network or database calls.
+
+`Descriptor` retains field presence, so explicit `false` and empty capability arrays survive normalization and fallback merging. Parsing accepts standard OpenAI/Anthropic lists, Codex manifests, Gemini lists and keyed Antigravity metadata. Limits are 2048 models, 256-byte IDs, 8 MiB across fetched pages and a 1 MiB stored snapshot. Failed, malformed or incomplete refreshes retain the previous successful snapshot. Successful snapshots remove models absent from the complete new catalog.
+
+The `accounts.extra.upstream_model_metadata` snapshot uses version 1 and a refresh-start generation. Persistence compares account credentials, platform/type, proxy identity and generation. Ordinary account edits preserve the latest snapshot under the existing account row lock; changing the upstream identity removes it. Unknown future versions remain opaque and are not replaced by this version. Existing `UpdateExtra` writers merge their fields and preserve the new key. No schema migration is required.
+
+Codex projection uses administrator `extra.model_metadata_overrides`, then explicit live upstream values, stored metadata, and compiled known-family defaults. The compiled JSON is generated from the reviewed repository price resource with `python3 backend/scripts/update-model-catalog.py` and currently includes 201 descriptors. Overrides are keyed by model ID, use the same validated descriptor fields, and may target an alias independently of its upstream target. Capability metadata never expands the account mapping or group allowlist. Projection copies the shared manifest and derives a body ETag after account mapping/metadata changes; serving a model manifest adds no per-request database or registry request.
+
+Run focused tests from `backend/`:
+
+```sh
+go test ./internal/modules/modelcatalog ./internal/application/service -run 'Catalog|Claude55'
+go test -tags=integration ./internal/infrastructure/repository -run TestModelCatalogPostgresRefreshAndLegacyWrites
+```
diff --git a/backend/internal/modules/modelcatalog/catalog.go b/backend/internal/modules/modelcatalog/catalog.go
new file mode 100644
index 000000000..cf81354be
--- /dev/null
+++ b/backend/internal/modules/modelcatalog/catalog.go
@@ -0,0 +1,201 @@
+// Package modelcatalog owns bounded provider-neutral discovery snapshots.
+package modelcatalog
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+	"unicode"
+)
+
+const (
+	Version          = 1
+	ExtraKey         = "upstream_model_metadata"
+	MaxModels        = 2048
+	MaxBodyBytes     = 8 << 20
+	MaxSnapshotBytes = 1 << 20
+)
+
+// Descriptor retains field presence: false and empty arrays are explicit values.
+// Only validated capability fields can enter a persisted descriptor.
+type Descriptor map[string]json.RawMessage
+
+type Catalog struct {
+	Models   []string              `json:"models"`
+	Metadata map[string]Descriptor `json:"metadata,omitempty"`
+}
+
+type Snapshot struct {
+	Version    int                   `json:"version"`
+	Source     string                `json:"source"`
+	StartedAt  time.Time             `json:"started_at"`
+	Generation int64                 `json:"generation"`
+	SyncedAt   time.Time             `json:"synced_at"`
+	Models     map[string]Descriptor `json:"models"`
+}
+
+func ValidID(id string) bool {
+	if id == "" || len(id) > 256 || strings.TrimSpace(id) != id {
+		return false
+	}
+	for _, r := range id {
+		if unicode.IsControl(r) || unicode.IsSpace(r) || r == '*' {
+			return false
+		}
+	}
+	return true
+}
+
+func (c *Catalog) Snapshot(source string, started time.Time) (*Snapshot, error) {
+	if c == nil || len(c.Models) == 0 || len(c.Models) > MaxModels {
+		return nil, fmt.Errorf("invalid catalog model count")
+	}
+	out := &Snapshot{Version: Version, Source: source, StartedAt: started.UTC(), Generation: started.UnixMicro(), SyncedAt: time.Now().UTC(), Models: make(map[string]Descriptor, len(c.Models))}
+	for _, id := range c.Models {
+		if !ValidID(id) {
+			return nil, fmt.Errorf("invalid model ID")
+		}
+		out.Models[id] = Normalize(c.Metadata[id], id)
+	}
+	raw, err := json.Marshal(out)
+	if err != nil || len(raw) > MaxSnapshotBytes {
+		return nil, fmt.Errorf("model metadata snapshot exceeds limit")
+	}
+	return out, nil
+}
+
+func ReadSnapshot(extra map[string]any) *Snapshot {
+	raw, err := json.Marshal(extra[ExtraKey])
+	if err != nil || len(raw) > MaxSnapshotBytes {
+		return nil
+	}
+	var snapshot Snapshot
+	if json.Unmarshal(raw, &snapshot) != nil || snapshot.Version != Version || len(snapshot.Models) > MaxModels {
+		return nil
+	}
+	// Revalidate persisted input, including records created by an older writer.
+	for id, d := range snapshot.Models {
+		if !ValidID(id) {
+			return nil
+		}
+		snapshot.Models[id] = Normalize(d, id)
+	}
+	return &snapshot
+}
+
+// Parse reads OpenAI, Codex, Anthropic, Gemini and keyed Antigravity catalogs.
+// IDs are supplied by the transport's existing provider-specific selector, so
+// Grok _meta IDs and other account routing semantics stay unchanged.
+func Parse(body []byte, ids []string) (map[string]Descriptor, error) {
+	if len(body) > MaxBodyBytes || len(ids) > MaxModels {
+		return nil, fmt.Errorf("model catalog exceeds limit")
+	}
+	var envelope map[string]json.RawMessage
+	if err := json.Unmarshal(body, &envelope); err != nil {
+		var array []json.RawMessage
+		if json.Unmarshal(body, &array) != nil {
+			return nil, err
+		}
+		envelope = map[string]json.RawMessage{"data": body}
+	}
+	wanted := make(map[string]bool, len(ids))
+	out := make(map[string]Descriptor, len(ids))
+	for _, id := range ids {
+		if !ValidID(id) {
+			return nil, fmt.Errorf("invalid model ID")
+		}
+		wanted[id] = true
+	}
+	raw, ok := envelope["data"]
+	if !ok {
+		raw = envelope["models"]
+	}
+	var entries []json.RawMessage
+	if json.Unmarshal(raw, &entries) != nil {
+		var keyed map[string]json.RawMessage
+		if err := json.Unmarshal(raw, &keyed); err != nil {
+			return nil, fmt.Errorf("invalid model catalog entries")
+		}
+		keys := make([]string, 0, len(keyed))
+		for id := range keyed {
+			keys = append(keys, id)
+		}
+		sort.Strings(keys)
+		for _, id := range keys {
+			var d Descriptor
+			if json.Unmarshal(keyed[id], &d) != nil || d == nil {
+				return nil, fmt.Errorf("invalid model descriptor")
+			}
+			d["id"], _ = json.Marshal(id)
+			encoded, _ := json.Marshal(d)
+			entries = append(entries, encoded)
+		}
+	}
+	if len(entries) > MaxModels {
+		return nil, fmt.Errorf("model catalog exceeds limit")
+	}
+	for _, raw := range entries {
+		var d Descriptor
+		if json.Unmarshal(raw, &d) != nil || d == nil {
+			return nil, fmt.Errorf("invalid model descriptor")
+		}
+		candidates := []string{}
+		for _, key := range []string{"id", "slug", "model", "modelId", "model_id", "name"} {
+			var id string
+			_ = json.Unmarshal(d[key], &id)
+			id = strings.TrimPrefix(strings.TrimSpace(id), "models/")
+			if id != "" {
+				candidates = append(candidates, id)
+			}
+		}
+		var meta map[string]json.RawMessage
+		if json.Unmarshal(d["_meta"], &meta) == nil {
+			for _, key := range []string{"id", "model", "modelId", "model_id", "name"} {
+				var id string
+				_ = json.Unmarshal(meta[key], &id)
+				candidates = append(candidates, strings.TrimSpace(id))
+			}
+		}
+		for _, id := range candidates {
+			if wanted[id] {
+				if previous, duplicate := out[id]; duplicate {
+					a, _ := json.Marshal(previous)
+					b, _ := json.Marshal(Normalize(d, id))
+					if string(a) != string(b) {
+						return nil, fmt.Errorf("conflicting model descriptor")
+					}
+					break
+				}
+				out[id] = Normalize(d, id)
+				break
+			}
+		}
+	}
+	for _, id := range ids {
+		if out[id] == nil {
+			return nil, fmt.Errorf("model descriptor missing from catalog")
+		}
+	}
+	return out, nil
+}
+
+// Fill applies fallbacks only to absent fields, never explicit false/empty/null.
+func Fill(primary, fallback Descriptor) Descriptor {
+	out := make(Descriptor, len(primary)+len(fallback))
+	for k, v := range fallback {
+		out[k] = append(json.RawMessage(nil), v...)
+	}
+	for k, v := range primary {
+		out[k] = append(json.RawMessage(nil), v...)
+	}
+	if string(primary["supports_reasoning"]) == "false" {
+		for _, key := range []string{"supported_reasoning_levels", "default_reasoning_level"} {
+			if _, ok := primary[key]; !ok {
+				delete(out, key)
+			}
+		}
+	}
+	return out
+}
