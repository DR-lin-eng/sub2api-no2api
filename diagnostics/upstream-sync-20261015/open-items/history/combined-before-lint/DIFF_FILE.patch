+//go:build unit
+
+package antigravity
+
+import (
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestTransformClaudeToGemini_ToolResultImagesReachUpstream(t *testing.T) {
+	claudeReq := &ClaudeRequest{
+		Model: "claude-sonnet-4-5",
+		Messages: []ClaudeMessage{
+			{
+				Role: "assistant",
+				Content: json.RawMessage(`[
+					{"type":"tool_use","id":"toolu_img_1","name":"read_image","input":{"path":"colors.png"}}
+				]`),
+			},
+			{
+				Role: "user",
+				Content: json.RawMessage(`[
+					{
+						"type":"tool_result",
+						"tool_use_id":"toolu_img_1",
+						"content":[
+							{"type":"text","text":"loaded colors.png"},
+							{"type":"image","source":{"type":"base64","media_type":"image/png","data":"aGVsbG8="}}
+						]
+					},
+					{
+						"type":"tool_result",
+						"tool_use_id":"toolu_img_1",
+						"content":[
+							{"type":"image","source":{"type":"base64","media_type":"image/jpeg","data":"d29ybGQ="}}
+						]
+					}
+				]`),
+			},
+		},
+	}
+
+	body, err := TransformClaudeToGeminiWithOptions(claudeReq, "project-1", "claude-sonnet-4-5", DefaultTransformOptions())
+	require.NoError(t, err)
+
+	var req V1InternalRequest
+	require.NoError(t, json.Unmarshal(body, &req))
+	require.Len(t, req.Request.Contents, 2)
+
+	userParts := req.Request.Contents[1].Parts
+	require.Len(t, userParts, 4)
+
+	require.NotNil(t, userParts[0].FunctionResponse)
+	require.Equal(t, "read_image", userParts[0].FunctionResponse.Name)
+	require.Equal(t, "toolu_img_1", userParts[0].FunctionResponse.ID)
+	require.Equal(t, "loaded colors.png", userParts[0].FunctionResponse.Response["result"])
+
+	require.NotNil(t, userParts[1].InlineData)
+	require.Equal(t, "image/png", userParts[1].InlineData.MimeType)
+	require.Equal(t, "aGVsbG8=", userParts[1].InlineData.Data)
+
+	require.NotNil(t, userParts[2].FunctionResponse)
+	require.Equal(t, "read_image", userParts[2].FunctionResponse.Name)
+	require.Equal(t, "Command executed successfully.", userParts[2].FunctionResponse.Response["result"])
+
+	require.NotNil(t, userParts[3].InlineData)
+	require.Equal(t, "image/jpeg", userParts[3].InlineData.MimeType)
+	require.Equal(t, "d29ybGQ=", userParts[3].InlineData.Data)
+}
diff --git a/backend/internal/shared/apicompat/anthropic_thinking_collector.go b/backend/internal/shared/apicompat/anthropic_thinking_collector.go
new file mode 100644
index 000000000..43d2b9a7e
--- /dev/null
+++ b/backend/internal/shared/apicompat/anthropic_thinking_collector.go
@@ -0,0 +1,75 @@
+package apicompat
+
+import "strings"
+
+// AnthropicSignedThinkingCollector preserves fragmented signatures in bridges
+// that buffer an upstream SSE response for a non-streaming client. Builders
+// avoid quadratic string concatenation on large thinking histories.
+type AnthropicSignedThinkingCollector struct {
+	blocks map[int]*anthropicThinkingFragments
+	failed bool
+}
+type anthropicThinkingFragments struct {
+	text      strings.Builder
+	signature strings.Builder
+	dataBytes int
+}
+
+func (c *AnthropicSignedThinkingCollector) Start(index int, block AnthropicContentBlock) {
+	if block.Type != "thinking" && block.Type != "redacted_thinking" {
+		return
+	}
+	if c.blocks == nil {
+		c.blocks = map[int]*anthropicThinkingFragments{}
+	}
+	if len(c.blocks) >= 128 || len(block.Thinking)+len(block.Signature)+len(block.Data) > maxAnthropicThinkingEnvelopeBytes {
+		c.failed = true
+		return
+	}
+	f := &anthropicThinkingFragments{dataBytes: len(block.Data)}
+	_, _ = f.text.WriteString(block.Thinking)
+	_, _ = f.signature.WriteString(block.Signature)
+	c.blocks[index] = f
+}
+
+func (c *AnthropicSignedThinkingCollector) Delta(index int, delta *AnthropicDelta) bool {
+	if delta == nil || (delta.Type != "thinking_delta" && delta.Type != "signature_delta") {
+		return false
+	}
+	f := c.blocks[index]
+	if f == nil {
+		c.failed = true
+		return true
+	}
+	value := delta.Thinking
+	if delta.Type == "signature_delta" {
+		value = delta.Signature
+	}
+	if f.text.Len()+f.signature.Len()+f.dataBytes+len(value) > maxAnthropicThinkingEnvelopeBytes {
+		c.failed = true
+		return true
+	}
+	if delta.Type == "thinking_delta" {
+		_, _ = f.text.WriteString(value)
+	} else {
+		_, _ = f.signature.WriteString(value)
+	}
+	return true
+}
+
+// Apply reports a protocol error while allowing the application to retain and
+// bill the usage already observed on the upstream response.
+func (c *AnthropicSignedThinkingCollector) Apply(response *AnthropicResponse) *ResponsesError {
+	for index, f := range c.blocks {
+		if index < 0 || index >= len(response.Content) {
+			c.failed = true
+			continue
+		}
+		response.Content[index].Thinking = f.text.String()
+		response.Content[index].Signature = f.signature.String()
+	}
+	if c.failed {
+		return &ResponsesError{Code: "thinking_replay_limit", Message: "Signed thinking exceeds the replay limit or has invalid block indices"}
+	}
+	return nil
+}
