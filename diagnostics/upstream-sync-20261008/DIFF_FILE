+func chatMessageJSON(t *testing.T, resp *ChatCompletionsResponse) map[string]any {
+	t.Helper()
+	raw, err := json.Marshal(resp)
+	require.NoError(t, err)
+	var decoded struct {
+		Choices []struct {
+			Message map[string]any `json:"message"`
+		} `json:"choices"`
