# 确保所有 SQL 迁移文件使用 LF 换行符
backend/migrations/*.sql text eol=lf

# Go 源代码文件
*.go text eol=lf

# 前端 源代码文件
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.vue text eol=lf

# Shell 脚本
*.sh text eol=lf

# YAML/YML 配置文件
*.yaml text eol=lf
*.yml text eol=lf

# Dockerfile
Dockerfile text eol=lf

# Unified patch context retains source indentation and blank context lines.
diagnostics/upstream-sync-20260905/DIFF_FILE -whitespace

# Preserve literal test output, patch context, and the final SSE event boundary.
diagnostics/stream-control-20260907/DIFF_FILE -whitespace
diagnostics/stream-control-20260907/*.txt -whitespace
backend/internal/application/service/testdata/openai_control_failure.sse whitespace=-blank-at-eof
